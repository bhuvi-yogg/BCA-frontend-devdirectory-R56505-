# ---- Frontend (public, safe to expose; NEVER put API keys here) ----
# Only needed if the AI proxy is deployed on a different origin than the site
VITE_AI_PROXY_URL=

# ---- AI proxy server (server/index.js). Keys stay server-side. ----
PORT=8787
AI_PRIMARY=openai          # openai | gemini | anthropic | local
AI_FALLBACK=               # optional, same values

OPENAI_API_KEY=
OPENAI_MODEL=              # set to a model your account can use
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM ...)
LOCAL_BASE_URL=            # e.g. http://localhost:11434/v1
LOCAL_API_KEY=
LOCAL_MODEL=
